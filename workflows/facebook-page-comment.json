    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-challenge",
      "name": "Responder hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 100]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": {
          "responseCode": 403
        }
      },
      "id": "respond-forbidden",
      "name": "Responder 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 260]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst processed = $getWorkflowStaticData('global');\nif (!processed.postIds) processed.postIds = {};\n\nconst pageId = ($env.FACEBOOK_PAGE_ID || '').trim();\nconst entries = body.entry || [];\nconst output = [];\n\nfor (const entry of entries) {\n  if (pageId && String(entry.id) !== String(pageId)) continue;\n\n  for (const change of (entry.changes || [])) {\n    if (change.field !== 'feed') continue;\n    const v = change.value || {};\n    if (v.item !== 'post' || v.verb !== 'add') continue;\n\n    const postId = v.post_id;\n    if (!postId) continue;\n    if (processed.postIds[postId]) continue;\n\n    output.push({\n      json: {\n        skip: false,\n        postId,\n        postMessage: v.message || '',\n        source: 'facebook_webhook'\n      }\n    });\n  }\n}\n\nif (!output.length) {\n  return [{ json: { skip: true, reason: 'no_new_post' } }];\n}\n\nreturn output;"
      },
      "id": "parse-facebook",
      "name": "Extrair post novo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "should-post",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-should-comment",
      "name": "Comentar no post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [900, 420]
    },
    {
      "parameters": {
        "jsCode": "const variants = [\n  'Deixa o like e se inscreve no canal — estamos na meta dos 100 mil! ❤️',\n  'Me ajuda a bater a meta de 100 mil inscritos? Se inscreve no canal ❤️',\n  'Estamos rumo aos 100K! Se ainda nao e inscrito, se inscreve aqui ❤️',\n  'Meta: 100 mil inscritos! Sua inscricao ajuda demais ❤️',\n  'Quer me ajudar na meta de 100 mil? E so se inscrever no canal ❤️',\n  'Faltam poucos pra meta de 100 mil inscritos — se inscreve no canal? ❤️',\n  'Se curtiu, se inscreve no canal! Estamos indo pros 100 mil ❤️',\n  'Me ajuda nessa meta de 100 mil inscritos se inscrevendo aqui ❤️',\n  'Bora juntos aos 100 mil inscritos? Se inscreve no canal ❤️',\n  'Obrigado por assistir! Me ajuda bater 100 mil inscritos se inscrevendo no canal ❤️',\n];\n\nconst item = $input.first().json;\nconst commentText = variants[Math.floor(Math.random() * variants.length)];\n\nreturn [{ json: { ...item, commentText } }];"
      },
      "id": "pick-comment-fb",
      "name": "Sortear comentario (10 variantes)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1010, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.postId }}/comments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.commentText }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 10000
          }
        }
      },
      "id": "post-facebook-comment",
      "name": "Postar comentario (Graph API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1230, 340]
    },
    {
      "parameters": {
        "jsCode": "const processed = $getWorkflowStaticData('global');\nif (!processed.postIds) processed.postIds = {};\n\nconst postId = $('Extrair post novo').item.json.postId;\nconst commentId = $json.id || 'unknown';\n\nprocessed.postIds[postId] = {\n  commentId,\n  postedAt: new Date().toISOString(),\n  source: 'facebook'\n};\n\nreturn [{\n  json: {\n    postId,\n    commentId,\n    pageUrl: `https://www.facebook.com/${postId}`,\n    message: 'Comentario postado na Pagina. Fixe manualmente se quiser.'\n  }\n}];"
      },
      "id": "save-processed-fb",
      "name": "Salvar post processado",
      "type": "n8n-nodes-base.code",
