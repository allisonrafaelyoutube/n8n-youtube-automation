{
  "name": "YouTube - Comentario automatico em videos novos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "schedule-trigger-fast",
      "name": "A cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "1 8,12,14,18,20 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-post-times",
      "name": "Horarios de postagem (8h 12h 14h 18h 20h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "url": "=https://www.youtube.com/feeds/videos.xml?channel_id={{ $env.YOUTUBE_CHANNEL_ID || 'UCxxxxxxxxxxxxxxxx' }}"
      },
      "id": "rss-feed",
      "name": "RSS do canal YouTube",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "recent-video",
              "leftValue": "={{ $json.pubDate || $json.isoDate }}",
              "rightValue": "={{ $now.minus({ minutes: 25 }).toISO() }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-recent",
      "name": "Video publicado nos ultimos 25 min",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst processed = $getWorkflowStaticData('global');\nif (!processed.videoIds) processed.videoIds = {};\n\nconst output = [];\nfor (const item of items) {\n  const link = item.json.link || item.json.guid || '';\n  const match = link.match(/(?:v=|\\/shorts\\/|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/);\n  const videoId = match ? match[1] : null;\n  if (!videoId) continue;\n  if (processed.videoIds[videoId]) continue;\n\n  output.push({\n    json: {\n      videoId,\n      title: item.json.title,\n      link,\n      pubDate: item.json.pubDate || item.json.isoDate\n    }\n  });\n}\n\nreturn output;"
      },
      "id": "extract-video-id",
      "name": "Extrair videoId e evitar duplicata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-video",
              "leftValue": "={{ $json.videoId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-new-video",
      "name": "Tem video novo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "jsCode": "const variants = [\n  'Me ajuda a bater a meta de 100 mil inscritos! Se inscrevam no canal ❤️',\n  'Estamos rumo aos 100 mil inscritos — me ajuda se inscrevendo no canal? ❤️',\n  'Quer me ajudar a bater a meta de 100K inscritos? Inscreva-se no canal ❤️',\n  'Meta: 100 mil inscritos! Se ainda nao e inscrito, se inscreve no canal ❤️',\n  'Me ajuda nessa meta de 100 mil inscritos se inscrevendo aqui no canal ❤️',\n];\n\nconst item = $input.first().json;\nconst commentText = variants[Math.floor(Math.random() * variants.length)];\n\nreturn [{ json: { ...item, commentText } }];"
      },
      "id": "pick-comment-rss",
      "name": "Sortear comentario (5 variantes)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/commentThreads",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"snippet\": {\n    \"videoId\": \"{{ $json.videoId }}\",\n    \"topLevelComment\": {\n      \"snippet\": {\n        \"textOriginal\": \"{{ $json.commentText }}\"\n      }\n    }\n  }\n}",
        "options": {
          "retry": {
            "maxTries": 4,
            "waitBetweenTries": 30000
          }
        }
      },
      "id": "post-comment",
      "name": "Postar comentario (YouTube API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 220],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "CONFIGURE_ME",
          "name": "YouTube OAuth - conta do canal"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const processed = $getWorkflowStaticData('global');\nif (!processed.videoIds) processed.videoIds = {};\n\nconst videoId = $('Extrair videoId e evitar duplicata').item.json.videoId;\nconst commentId = $json.id || 'unknown';\n\nprocessed.videoIds[videoId] = {\n  commentId,\n  postedAt: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    videoId,\n    commentId,\n    title: $('Extrair videoId e evitar duplicata').item.json.title,\n    studioUrl: `https://studio.youtube.com/video/${videoId}/comments`,\n    message: 'Comentario postado. Fixe manualmente no YouTube Studio (pin nao existe na API).'\n  }\n}];"
      },
      "id": "save-processed",
      "name": "Salvar video processado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 220]
    }
  ],
  "connections": {
